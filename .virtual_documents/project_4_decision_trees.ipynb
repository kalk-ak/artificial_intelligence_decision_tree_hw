# 4. min_samples_leaf is respected everywhere
def leaf_sizes(node):
    """Sample counts of every leaf below a node."""
    if node.is_leaf():
        return [node.n_samples]
    sizes = []
    for child in node.children.values():
        sizes.extend(leaf_sizes(child))
    return sizes


