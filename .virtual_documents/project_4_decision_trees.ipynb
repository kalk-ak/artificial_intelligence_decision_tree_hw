def split_counts(node: Node, counter: Optional[Counter] = None) -> Counter:
    """How many internal nodes test each feature."""
    if counter is None:
        counter = Counter()
    if not node.is_leaf():
        counter[node.feature] += 1
        for child in node.children.values():
            split_counts(child, counter)
    return counter


